# Base de datos PostgreSQL (Neon). Cadena de conexión de tu proyecto Neon.
# Formato Neon: postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# Secreto de NextAuth (JWT). Genera uno con: openssl rand -base64 32
# IMPORTANTE: en producción usa una variable real y distinta de desarrollo.
NEXTAUTH_SECRET="genera-un-secreto-con-openssl-rand-base64-32"

# URL pública de la app (en Vercel es https://tu-app.vercel.app, en local http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"